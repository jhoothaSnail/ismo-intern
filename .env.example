# ── API ───────────────────────────────────────────────────────────────────────

# Primary connection (used by Prisma Client at runtime). Pooled URL if provider offers one.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Direct (non-pooled) URL. Required for `prisma migrate deploy` when using a pooler.
DIRECT_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# HS256 secret for access JWTs. Must be at least 32 characters. App exits if shorter.
JWT_ACCESS_SECRET=changeme_min_32_chars_xxxxxxxxxx

# Comma-separated exact origins allowed by CORS (no trailing slash, no wildcards).
# Example: https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173

# Number of trusted reverse-proxy hops in front of the API.
# Set after running spike S5. Wrong value breaks IP-based rate limiting.
TRUST_PROXY_HOPS=0

# Port the API listens on.
PORT=3000

# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

NODE_ENV=development

# ── Mobile (build-time, Expo inlines EXPO_PUBLIC_* vars) ──────────────────────

# Base URL of the deployed API. Never put secrets here — it is visible in the APK.
EXPO_PUBLIC_API_URL=http://localhost:3000
